    /* ===== Collection Match Rules ===== */
    match /test/{docId} {
      allow get: if isSignedIn() && isValidId(docId) && docId == 'connection';
      allow list, create, update, delete: if false;
    }

    match /profiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (
        userId == request.auth.uid
        || exists(/databases/$(database)/documents/teacher_students/$(request.auth.uid + '_' + userId))
        || exists(/databases/$(database)/documents/student_teachers/$(request.auth.uid + '_' + userId))
      );
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidProfile(incoming())
        && userId == request.auth.uid
        && incoming().id == request.auth.uid
        && isServerCreated(incoming());
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidProfile(incoming())
        && userId == request.auth.uid
        && existing().id == request.auth.uid
        && incoming().id == existing().id
        && incoming().role == existing().role
        && incoming().email == existing().email
        && isServerUpdated(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['full_name', 'updatedAt']);
      allow delete: if false;
    }

    match /email_index/{emailHash} {
      allow get: if isVerifiedUser() && isValidId(emailHash) && (
        isTeacherAccount() || (resource != null && existing().user_id == request.auth.uid)
      );
