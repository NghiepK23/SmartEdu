rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    /* ===== Global Security Primitives ===== */
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isOptId(data, field) {
      return !(field in data) || data[field] == null || isValidId(data[field]);
    }
    function isOptStr(data, field, maxLen) {
      return !(field in data) || data[field] == null || (data[field] is string && data[field].size() <= maxLen);
    }
    function isOptInt(data, field) {
      return !(field in data) || data[field] == null || data[field] is int;
    }
    function isOptNum(data, field) {
      return !(field in data) || data[field] == null || data[field] is int || data[field] is float;
    }
    function isOptNumRange(data, field, minVal, maxVal) {
      return !(field in data) || data[field] == null || ((data[field] is int || data[field] is float) && data[field] >= minVal && data[field] <= maxVal);
    }
    function isOptIntRange(data, field, minVal, maxVal) {
      return !(field in data) || data[field] == null || (data[field] is int && data[field] >= minVal && data[field] <= maxVal);
    }
    function isOptBool(data, field) {
      return !(field in data) || data[field] == null || data[field] is bool;
    }
    function isOptMap(data, field) {
      return !(field in data) || data[field] == null || data[field] is map;
    }
    function isBoundedIdList(val, maxLen) {
      return val is list && val.size() <= maxLen && (val.size() == 0 || isValidId(val[0]));
    }
    function isOptBoundedIdList(data, field, maxLen) {
      return !(field in data) || data[field] == null || isBoundedIdList(data[field], maxLen);
    }
    function isOptOptions(data, field) {
      return !(field in data) || data[field] == null
        || (data[field] is list && data[field].size() <= 30)
        || (data[field] is map && data[field].keys().hasOnly(['left', 'right']));
    }
    function isOptAnswerVal(data, field) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].size() <= 10000)
        || data[field] is int
        || data[field] is float
        || data[field] is bool
        || (data[field] is list && data[field].size() <= 40);
    }
    function isServerCreated(data) {
      return data.createdAt == request.time && data.updatedAt == request.time;
    }
    function isServerUpdated(data) {
      return data.createdAt == existing().createdAt && data.updatedAt == request.time;
    }

    function isTeacherAccount() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/profiles/$(request.auth.uid))
        && get(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.role == 'TEACHER';
    }
    function isClassTeacher(classId) {
      return isVerifiedUser()
        && isValidId(classId)
        && exists(/databases/$(database)/documents/classes/$(classId))
        && get(/databases/$(database)/documents/classes/$(classId)).data.owner_teacher_id == request.auth.uid;
    }
    function isClassStudent(classId) {
      return isSignedIn()
        && isValidId(classId)
        && exists(/databases/$(database)/documents/class_members/$(classId + '_' + request.auth.uid));
    }
    function isClassParticipant(classId) {
      return isClassTeacher(classId) || isClassStudent(classId);
    }

    /* ===== Validation Blueprints ===== */
    function isValidProfile(data) {
      return data.keys().hasAll(['id', 'email', 'full_name', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'email', 'full_name', 'role', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 320
        && data.full_name is string && data.full_name.size() >= 1 && data.full_name.size() <= 120
        && data.role in ['STUDENT', 'TEACHER']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidEmailIndex(data) {
      return data.keys().hasAll(['email_hash', 'user_id', 'role', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['email_hash', 'user_id', 'role', 'createdAt', 'updatedAt'])
        && data.email_hash is string && data.email_hash.size() == 64 && data.email_hash.matches('^[a-f0-9]+$')
        && isValidId(data.user_id)
        && data.role in ['STUDENT', 'TEACHER']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRosterLink(data) {
      return data.keys().hasAll(['id', 'teacher_id', 'student_id', 'class_id', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'teacher_id', 'student_id', 'class_id', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.teacher_id)
        && isValidId(data.student_id)
        && isValidId(data.class_id)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClass(data) {
      return data.keys().hasAll(['id', 'name', 'owner_teacher_id', 'created_at', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'name', 'grade', 'school_year', 'owner_teacher_id', 'created_at', 'deleted_at', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 100
        && isOptInt(data, 'grade')
        && isOptStr(data, 'school_year', 20)
        && isValidId(data.owner_teacher_id)
        && data.created_at is string && data.created_at.size() <= 40
        && isOptStr(data, 'deleted_at', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassInvite(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'code', 'created_at', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'code', 'created_at', 'expires_at', 'revoked_at', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && data.code is string && data.code.size() >= 6 && data.code.size() <= 12 && data.code.matches('^[A-Z0-9]+$')
        && data.created_at is string && data.created_at.size() <= 40
        && isOptStr(data, 'expires_at', 40)
        && isOptStr(data, 'revoked_at', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassInviteCode(data) {
      return data.keys().hasAll(['code', 'invite_id', 'class_id', 'teacher_id', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['code', 'invite_id', 'class_id', 'teacher_id', 'revoked_at', 'expires_at', 'createdAt', 'updatedAt'])
        && data.code is string && data.code.size() >= 6 && data.code.size() <= 12 && data.code.matches('^[A-Z0-9]+$')
        && isValidId(data.invite_id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isOptStr(data, 'revoked_at', 40)
        && isOptStr(data, 'expires_at', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassMember(data) {
      return data.keys().hasAll(['id', 'class_id', 'student_id', 'teacher_id', 'joined_at', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'student_id', 'teacher_id', 'joined_at', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.student_id)
        && isValidId(data.teacher_id)
        && data.joined_at is string && data.joined_at.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    /* userId có phải giáo viên chủ lớp đang dạy người gọi không (dùng cho ai_keys). */
    function isSharedTeacherKey(userId) {
      return exists(/databases/$(database)/documents/student_teachers/$(request.auth.uid + '_' + userId))
        && exists(/databases/$(database)/documents/profiles/$(userId))
        && get(/databases/$(database)/documents/profiles/$(userId)).data.role == 'TEACHER';
    }

    function isValidAiKey(data) {
      return data.keys().hasAll(['id', 'ciphertext', 'iv', 'tag', 'key_hint', 'created_at', 'updated_at', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ciphertext', 'iv', 'tag', 'key_hint', 'created_at', 'updated_at', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && data.ciphertext is string && data.ciphertext.size() >= 16 && data.ciphertext.size() <= 1024
        && data.iv is string && data.iv.size() >= 8 && data.iv.size() <= 64
        && data.tag is string && data.tag.size() >= 8 && data.tag.size() <= 64
        && data.key_hint is string && data.key_hint.size() >= 2 && data.key_hint.size() <= 4
        && data.created_at is string && data.created_at.size() <= 40
        && data.updated_at is string && data.updated_at.size() <= 40
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourse(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'title', 'created_at', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'class_id', 'teacher_id', 'title', 'description', 'sequential_unlock',
          'practice_weight', 'practice_unlock_min_official', 'practice_session_length', 'practice_daily_scored_sessions', 'practice_max_share',
          'dash_reteach_share', 'dash_min_students', 'dash_advanced_threshold', 'dash_inactive_days', 'dash_question_min_answers',
          'created_at', 'deleted_at', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && isOptStr(data, 'description', 4000)
        && isOptBool(data, 'sequential_unlock')
        && isOptNumRange(data, 'practice_weight', 0, 1)
        && isOptIntRange(data, 'practice_unlock_min_official', 0, 50)
        && isOptIntRange(data, 'practice_session_length', 1, 50)
        && isOptIntRange(data, 'practice_daily_scored_sessions', 0, 50)
        && isOptNumRange(data, 'practice_max_share', 0, 0.95)
        && isOptNumRange(data, 'dash_reteach_share', 0, 1)
        && isOptIntRange(data, 'dash_min_students', 1, 200)
        && isOptNumRange(data, 'dash_advanced_threshold', 0, 1)
        && isOptIntRange(data, 'dash_inactive_days', 1, 365)
        && isOptIntRange(data, 'dash_question_min_answers', 1, 200)
        && data.created_at is string && data.created_at.size() <= 40
        && isOptStr(data, 'deleted_at', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidClassIndex(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'topic_ids', 'lesson_ids', 'objective_ids', 'resource_ids', 'resource_objective_link_ids', 'assignment_ids', 'assessment_ids', 'question_ids', 'criterion_ids', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isOptBoundedIdList(data, 'topic_ids', 500)
        && isOptBoundedIdList(data, 'lesson_ids', 500)
        && isOptBoundedIdList(data, 'objective_ids', 1000)
        && isOptBoundedIdList(data, 'resource_ids', 1000)
        && isOptBoundedIdList(data, 'resource_objective_link_ids', 2000)
        && isOptBoundedIdList(data, 'assignment_ids', 500)
        && isOptBoundedIdList(data, 'assessment_ids', 500)
        && isOptBoundedIdList(data, 'question_ids', 2000)
        && isOptBoundedIdList(data, 'criterion_ids', 1000)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCourseTopic(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'course_id', 'title', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'course_id', 'title', 'description', 'display_order', 'status', 'created_at', 'deleted_at', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.course_id)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && isOptStr(data, 'description', 8000)
        && isOptInt(data, 'display_order')
        && data.status in ['DRAFT', 'PUBLISHED']
        && isOptStr(data, 'created_at', 40)
        && isOptStr(data, 'deleted_at', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLesson(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'course_id', 'title', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'course_id', 'topic_id', 'title', 'description', 'display_order', 'status', 'created_at', 'deleted_at', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.course_id)
        && isOptId(data, 'topic_id')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && isOptStr(data, 'description', 8000)
        && isOptInt(data, 'display_order')
        && data.status in ['DRAFT', 'PUBLISHED']
        && isOptStr(data, 'created_at', 40)
        && isOptStr(data, 'deleted_at', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidObjective(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'course_id', 'lesson_id', 'code', 'description', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'course_id', 'lesson_id', 'code', 'description', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.course_id)
        && isValidId(data.lesson_id)
        && data.code is string && data.code.size() >= 1 && data.code.size() <= 80
        && data.description is string && data.description.size() >= 1 && data.description.size() <= 2000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidResource(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'course_id', 'lesson_id', 'kind', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'course_id', 'lesson_id', 'kind', 'url', 'file_name', 'storage_path', 'file_size_bytes', 'mime_type', 'created_at', 'deleted_at', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.course_id)
        && isValidId(data.lesson_id)
        && data.kind is string && data.kind.size() <= 40
        && isOptStr(data, 'url', 2000)
        && isOptStr(data, 'file_name', 300)
        && isOptStr(data, 'storage_path', 500)
        && isOptInt(data, 'file_size_bytes')
        && isOptStr(data, 'mime_type', 120)
        && isOptStr(data, 'created_at', 40)
        && isOptStr(data, 'deleted_at', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidResourceObjectiveLink(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'course_id', 'resource_id', 'objective_id', 'purpose', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'course_id', 'resource_id', 'objective_id', 'purpose', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.course_id)
        && isValidId(data.resource_id)
        && isValidId(data.objective_id)
        && data.purpose in ['LEARN', 'PRACTICE', 'EXTEND']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuestion(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'course_id', 'created_by', 'content', 'kind', 'difficulty', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'course_id', 'created_by', 'content', 'kind', 'options', 'correct_answer', 'explain', 'difficulty', 'grade', 'bloom_level', 'objective_ids', 'deleted_at', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.course_id)
        && isValidId(data.created_by)
        && data.content is string && data.content.size() >= 1 && data.content.size() <= 5000
        && data.kind in ['SINGLE_CHOICE', 'MULTIPLE_CHOICE', 'TRUE_FALSE', 'FILL_IN_BLANK', 'MATCHING', 'SHORT_ANSWER', 'ESSAY']
        && isOptOptions(data, 'options')
        && isOptAnswerVal(data, 'correct_answer')
        && isOptStr(data, 'explain', 5000)
        && data.difficulty in ['EASY', 'MEDIUM', 'HARD']
        && isOptInt(data, 'grade')
        && isOptStr(data, 'bloom_level', 40)
        && isOptBoundedIdList(data, 'objective_ids', 50)
        && isOptStr(data, 'deleted_at', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidQuestionObjective(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'question_id', 'objective_id', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'question_id', 'objective_id', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.question_id)
        && isValidId(data.objective_id)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAssignment(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'created_by', 'course_id', 'title', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'created_by', 'course_id', 'topic_id', 'lesson_id', 'title', 'description', 'due_at', 'allow_late', 'late_close_at', 'max_score', 'status', 'objective_ids', 'question_ids', 'target_mode', 'target_group', 'target_student_ids', 'student_ai_enabled', 'created_at', 'deleted_at', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.created_by)
        && isValidId(data.course_id)
        && isOptId(data, 'topic_id')
        && isOptId(data, 'lesson_id')
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 300
        && isOptStr(data, 'description', 8000)
        && isOptStr(data, 'due_at', 40)
        && isOptBool(data, 'allow_late')
        && isOptStr(data, 'late_close_at', 40)
        && isOptNum(data, 'max_score')
        && isOptBool(data, 'student_ai_enabled')
        && data.status in ['DRAFT', 'PUBLISHED']
        && isOptBoundedIdList(data, 'objective_ids', 100)
        && isOptBoundedIdList(data, 'question_ids', 200)
        && (!('target_mode' in data) || data.target_mode == null || data.target_mode in ['ALL', 'TARGETED'])
        && isOptStr(data, 'target_group', 40)
        && isOptBoundedIdList(data, 'target_student_ids', 500)
        && isOptStr(data, 'created_at', 40)
        && isOptStr(data, 'deleted_at', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAssignmentTarget(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'assignment_id', 'student_id', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'assignment_id', 'student_id', 'target_group', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.assignment_id)
        && isValidId(data.student_id)
        && isOptStr(data, 'target_group', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAssignmentObjective(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'assignment_id', 'objective_id', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'assignment_id', 'objective_id', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.assignment_id)
        && isValidId(data.objective_id)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAssignmentQuestion(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'assignment_id', 'question_id', 'display_order', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'assignment_id', 'question_id', 'display_order', 'weight', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.assignment_id)
        && isValidId(data.question_id)
        && data.display_order is int
        && isOptNum(data, 'weight')
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAssignmentSubmission(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'assignment_id', 'student_id', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'class_id', 'teacher_id', 'assignment_id', 'student_id', 'text_content', 'storage_path', 'file_name', 'status', 'score', 'feedback', 'graded_by', 'graded_at', 'is_edited', 'question_grading_enabled', 'submitted_at', 'deleted_at', 'createdAt', 'updatedAt'])
        && isValidId(data.id)
        && isValidId(data.class_id)
        && isValidId(data.teacher_id)
        && isValidId(data.assignment_id)
        && isValidId(data.student_id)
        && isOptStr(data, 'text_content', 20000)
        && isOptStr(data, 'storage_path', 500)
        && isOptStr(data, 'file_name', 300)
        && data.status in ['SUBMITTED', 'LATE', 'GRADED']
        && isOptNum(data, 'score')
        && isOptStr(data, 'feedback', 5000)
        && isOptId(data, 'graded_by')
        && isOptStr(data, 'graded_at', 40)
        && isOptBool(data, 'is_edited')
        && isOptBool(data, 'question_grading_enabled')
        && isOptStr(data, 'submitted_at', 40)
        && isOptStr(data, 'deleted_at', 40)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAssignmentSubmissionAnswer(data) {
      return data.keys().hasAll(['id', 'class_id', 'teacher_id', 'submission_id', 'student_id', 'question_id', 'createdAt', 'updatedAt'])
