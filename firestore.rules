    /* API key Gemini của từng người: mỗi người chỉ ghi tài liệu của mình; đọc thì chủ sở hữu
       hoặc giáo viên chủ lớp của người gọi (học sinh dùng chung key giáo viên).
       Nội dung là bản mã AES-256-GCM do máy chủ Express tạo (khoá nằm trong biến môi trường máy chủ),
       nên kể cả khi đọc được tài liệu cũng không lấy được key thô. */
    match /ai_keys/{userId} {
      allow get: if isVerifiedUser()
        && isValidId(userId)
        && (
          userId == request.auth.uid
          /* Học sinh đọc key của giáo viên chủ lớp: máy chủ Express dùng ID token của học sinh
             để lấy bản mã rồi giải mã tại chỗ (học sinh không bao giờ nhận key thô). */
          || isSharedTeacherKey(userId)
        );
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidAiKey(incoming())
        && userId == request.auth.uid
        && incoming().id == request.auth.uid
        && isServerCreated(incoming());
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidAiKey(incoming())
        && userId == request.auth.uid
        && existing().id == request.auth.uid
        && incoming().id == existing().id
        && existing().created_at is string
        && isServerUpdated(incoming());
      allow delete: if isVerifiedUser() && isValidId(userId) && userId == request.auth.uid;
    }

    match /ai_chat_messages/{messageId} {
      allow get: if isSignedIn() && isValidId(messageId) && existing().user_id == request.auth.uid;
      allow list: if isSignedIn() && existing().user_id == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(messageId)
        && isValidAiChatMessage(incoming())
        && incoming().id == messageId
        && incoming().user_id == request.auth.uid
        && isServerCreated(incoming())
        && existsAfter(/databases/$(database)/documents/ai_chat_threads/$(incoming().thread_id));
      allow update: if false;
      allow delete: if isVerifiedUser() && isValidId(messageId) && existing().user_id == request.auth.uid;
    }
  }
}
